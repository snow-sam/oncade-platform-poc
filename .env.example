# Test platform API key from https://dev.oncade.xyz (Platform > API Keys). Starts with oncade_platform_test_
ONCADE_API_KEY=

# Webhook secret from https://dev.oncade.xyz (Platform > Settings). Shown once.
ONCADE_WEBHOOK_SECRET=

# API host. Docs: "There is no separate test host" - the key decides the environment.
ONCADE_BASE_URL=https://www.oncade.gg/api

# Owner of the business the flow creates (they may receive an invite email).
BUSINESS_OWNER_EMAIL=

# Who the test invoice is addressed to. Emails are suppressed unless SEND_INVOICE_EMAIL=true.
INVOICE_RECEIVER_EMAIL=test-receiver@example.com
SEND_INVOICE_EMAIL=false

# Invoices require a payoutWallet on the business. Test environment only - any valid address works.
PAYOUT_WALLET=0x000000000000000000000000000000000000dEaD

# Optional: reuse an existing business instead of creating one each run.
ONCADE_BUSINESS_ID=

WEBHOOK_PORT=3000
# Log every request/response (API key redacted)
ONCADE_DEBUG=false
